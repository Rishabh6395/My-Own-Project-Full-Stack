{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Builder",
      "cwd": "${workspaceFolder}/apps/builder",
      "program": "${workspaceFolder}/apps/builder/src/index.ts",
      "preLaunchTask": "tsc: build - apps/builder/tsconfig.json",
      "outFiles": ["${workspaceFolder}/apps/builder/dist/**/*.js"],
      "skipFiles": ["<node_internals>/**"],
      "env": {
        "NODE_ENV": "development"
      },
      "console": "integratedTerminal",
      "restart": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Builder (ts-node, no build step)",
      "cwd": "${workspaceFolder}/apps/builder",
      "runtimeArgs": ["-r", "ts-node/register"],
      "program": "${workspaceFolder}/apps/builder/src/index.ts",
      "skipFiles": ["<node_internals>/**"],
      "env": {
        "NODE_ENV": "development"
      },
      "console": "integratedTerminal",
      "restart": true
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach to Builder Process",
      "port": 9229,
      "restart": true,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}